<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchiTech.Api\ArchiTech.Api.csproj" />
    <ProjectReference Include="..\ArchiTech.DataTransfer\ArchiTech.DataTransfer.csproj" />
    <ProjectReference Include="..\ArchiTech.ReadOnlyWorker\ArchiTech.ReadOnlyWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ArchiTech.Api\Data\secure-plus-wbs-tasks.csv" Link="Data\secure-plus-wbs-tasks.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\ArchiTech.Api\Data\deployment-controls-v2.0.json" Link="Data\deployment-controls-v2.0.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\ArchiTech.Api\Data\standards\**\*" Link="Data\standards\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>