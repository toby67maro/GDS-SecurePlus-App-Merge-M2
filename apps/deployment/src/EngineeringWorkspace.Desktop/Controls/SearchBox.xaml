<UserControl x:Class="EngineeringWorkspace.Desktop.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" MinWidth="200">
    <!-- One search box for the whole application: magnifying glass, placeholder, clear (×) and debounced input. -->
    <Border x:Name="Frame" Background="{DynamicResource AppBrush.InputBackground}" BorderBrush="{DynamicResource AppBrush.InputBorder}" BorderThickness="1"
            CornerRadius="{DynamicResource AppCorner.Default}" MinHeight="{DynamicResource AppLayout.InputMinHeight}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE721;" FontSize="13" Margin="9,0,4,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppBrush.TextSecondary}" AutomationProperties.Name="Search" />
            <TextBlock x:Name="PlaceholderText" Grid.Column="1" Text="{Binding Placeholder, ElementName=Root}" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource AppBrush.TextDisabled}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="2,0" Margin="0" VerticalContentAlignment="Center"
                     MinHeight="0" Foreground="{DynamicResource AppBrush.TextPrimary}" CaretBrush="{DynamicResource AppBrush.TextPrimary}"
                     AutomationProperties.Name="{Binding Placeholder, ElementName=Root}" />
            <Button x:Name="Clear" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Padding="8,0" Margin="0"
                    MinHeight="0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource AppBrush.TextSecondary}" Cursor="Hand"
                    ToolTip="Clear the search" AutomationProperties.Name="Clear the search" Visibility="Collapsed" Focusable="False" />
        </Grid>
    </Border>
</UserControl>
