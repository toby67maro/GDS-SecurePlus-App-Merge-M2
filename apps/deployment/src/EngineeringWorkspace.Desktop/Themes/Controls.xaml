<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:EngineeringWorkspace.Application.Common;assembly=EngineeringWorkspace.Application"
                    xmlns:tenants="clr-namespace:EngineeringWorkspace.Application.Tenants;assembly=EngineeringWorkspace.Application"
                    xmlns:credentials="clr-namespace:EngineeringWorkspace.Domain.Credentials;assembly=EngineeringWorkspace.Domain"
                    xmlns:database="clr-namespace:EngineeringWorkspace.Application.Database;assembly=EngineeringWorkspace.Application"
                    xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
                    xmlns:converters="clr-namespace:EngineeringWorkspace.Desktop.Converters">
    <!--
        Control styles for every view. All colors, fonts and sizes come from the theme dictionary built by
        ThemeResourceBuilder (AppColor.*, AppBrush.*, AppFont.*, AppLayout.*, AppSpacing.*, AppCorner.*)
        through DynamicResource, so a theme change applies live. Never hard-code those values in views.
    -->

    <converters:InverseBooleanConverter x:Key="Controls.InverseBool" />

    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{DynamicResource AppBrush.Accent}" StrokeDashArray="1 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.ApplicationBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Base}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Heading1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Heading1}" />
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Heading}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Heading2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Heading1}">
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Heading2}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style x:Key="Text.Heading3" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Heading1}">
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Heading3}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Caption}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style x:Key="Text.Error" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Cards are raised slightly (soft shadow) so pages have depth instead of looking flat. -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCorner.Large}" />
        <Setter Property="Padding" Value="{DynamicResource AppSpacing.L}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.Secondary" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCorner.Default}" />
        <Setter Property="Padding" Value="{DynamicResource AppSpacing.M}" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Background" Value="{DynamicResource AppBrush.ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.ButtonBackground}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Button}" />
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Medium}" />
        <Setter Property="MinHeight" Value="{DynamicResource AppLayout.ButtonMinHeight}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppCorner.Default}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppBrush.ButtonHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppBrush.ButtonPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.InputBorder}" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Error}" />
    </Style>

    <Style x:Key="Input.Base" TargetType="{x:Type Control}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource AppBrush.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.InputForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{DynamicResource AppLayout.InputMinHeight}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Base}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Accent}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextDisabled}" />
                <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource AppBrush.InputForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppBrush.Accent}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource AppBrush.InputForeground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AppBrush.Accent}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="MinHeight" Value="{DynamicResource AppLayout.ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Base}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Margin" Value="0,6,16,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
        <Setter Property="RowBackground" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBrush.Divider}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBrush.Divider}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Small}" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Medium}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppBrush.NavigationSelectedBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.NavigationSelectedForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- State text: set Tag to the state value; colors come from theme brushes and update live. -->
    <Style x:Key="Text.State" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}" />
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Medium}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static common:CheckState.Passed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static common:CheckState.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static common:CheckState.Failed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static credentials:CredentialStatus.Configured}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static credentials:CredentialStatus.ExpiresSoon}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static credentials:CredentialStatus.Expired}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static credentials:CredentialStatus.Missing}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static credentials:CredentialStatus.Invalid}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.Connected}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.AuthenticationFailed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.GraphConnectionFailed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.PermissionValidationFailed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.CredentialMissing}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static tenants:TenantConnectionState.CredentialExpired}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static database:DatabaseOverallState.Ready}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static database:DatabaseOverallState.MigrationRequired}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static database:DatabaseOverallState.ConnectionFailed}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static database:DatabaseOverallState.IncompatibleSchema}">
                <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Resizable table host: drag the bottom grip to change the height, or Expand to open it full screen. -->
    <Style TargetType="{x:Type controls:ResizablePanel}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ResizablePanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="PART_Expand" DockPanel.Dock="Right" Content="&#x2922; Expand" Style="{StaticResource Button.Secondary}" Padding="8,2" Margin="0"
                                    ToolTip="Open this table in a separate, full-screen window. Close that window to bring it back." AutomationProperties.Name="Expand" />
                            <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Grid.Row="1" Height="{TemplateBinding PanelHeight}" MinHeight="{TemplateBinding MinPanelHeight}">
                            <Grid>
                                <ContentPresenter />
                                <TextBlock Text="Shown in the expanded window. Close it to bring the table back." Style="{StaticResource Text.Secondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ExpandedHint" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_Grip" Grid.Row="2" Height="8" Cursor="SizeNS" ToolTip="Drag to resize" Background="{DynamicResource AppBrush.Divider}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="Transparent">
                                        <Border Height="3" Width="48" CornerRadius="1.5" Background="{TemplateBinding Background}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedHint" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Drop-down button used by the multi-select filter: looks like an input, opens a popup. -->
    <Style x:Key="DropDown.Toggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Background" Value="{DynamicResource AppBrush.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.InputForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.InputBorder}" />
        <Setter Property="MinHeight" Value="{DynamicResource AppLayout.InputMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource AppCorner.Default}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBrush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-select drop-down: "Select All" plus one checkbox per option. Render with <ContentControl Content="{Binding SomeFilter}" />. -->
    <DataTemplate DataType="{x:Type controls:MultiSelectFilter}">
        <Grid MinWidth="160">
            <ToggleButton x:Name="Toggle" Style="{StaticResource DropDown.Toggle}" IsChecked="{Binding IsOpen, Mode=TwoWay}"
                          IsHitTestVisible="{Binding IsOpen, Converter={StaticResource Controls.InverseBool}}"
                          AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Summary}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppBrush.TextSecondary}" />
                </Grid>
            </ToggleButton>
            <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" AllowsTransparency="True"
                   PopupAnimation="Fade" MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                <Border Background="{DynamicResource AppBrush.SurfaceBackground}" BorderBrush="{DynamicResource AppBrush.Border}" BorderThickness="1"
                        CornerRadius="{DynamicResource AppCorner.Default}" Padding="8,4" Margin="0,2,6,6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel>
                        <CheckBox Content="Select All" IsChecked="{Binding AllSelected, Mode=TwoWay}" FontWeight="{DynamicResource AppFont.Weight.Medium}" Margin="0,4" />
                        <Separator Margin="0,2" Background="{DynamicResource AppBrush.Divider}" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DataTemplate>

    <!-- On/Off switch for CheckBoxes (for example a schedule's State); saves through its binding. -->
    <Style x:Key="Toggle.Switch" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="18" CornerRadius="9" Background="{DynamicResource AppBrush.SurfaceSecondary}"
                                BorderBrush="{DynamicResource AppBrush.InputBorder}" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource AppBrush.TextSecondary}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Border>
                        <TextBlock x:Name="Caption" Text="Off" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AppBrush.TextSecondary}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AppBrush.Secondary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AppBrush.Secondary}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AppBrush.SecondaryForeground}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Caption" Property="Text" Value="On" />
                            <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible section with a consistent header (Control Details and other detail panels). -->
    <Style x:Key="Section.Expander" TargetType="{x:Type Expander}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Expander}">
                    <Border BorderBrush="{DynamicResource AppBrush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource AppCorner.Default}"
                            Background="{DynamicResource AppBrush.SurfaceBackground}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand"
                                          FocusVisualStyle="{StaticResource Focus.Visual}" AutomationProperties.Name="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="HeaderChrome" Background="{DynamicResource AppBrush.SurfaceSecondary}" Padding="10,7"
                                                CornerRadius="{DynamicResource AppCorner.Default}">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppBrush.Secondary}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}" VerticalAlignment="Center"
                                                                  TextElement.FontWeight="{DynamicResource AppFont.Weight.Heading}"
                                                                  TextElement.Foreground="{DynamicResource AppBrush.TextPrimary}" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource AppBrush.Divider}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="10,8,10,10" Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-8" To="0"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Summary KPI tile. -->
    <Style x:Key="Kpi.Tile" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Secondary}" />
        <Setter Property="BorderThickness" Value="4,1,1,1" />
        <Setter Property="CornerRadius" Value="{DynamicResource AppCorner.Default}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="controls:Motion.HoverLift" Value="True" />
    </Style>
    <Style x:Key="Text.KpiValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Heading2}" />
        <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Heading}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Primary}" />
    </Style>

    <!-- Code view (Graph request bodies, scripts): monospace, wraps, selectable. -->
    <Style x:Key="Text.Code" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="{DynamicResource AppFont.Size.Small}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MaxHeight" Value="320" />
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
    </Style>

    <!-- Small helper text under an input ("Max is 20"). -->
    <Style x:Key="Text.Helper" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextDisabled}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Status chip for a customer that was added to a list (with a Remove button). -->
    <Style x:Key="Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,2,4,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <!-- 4.0 top-bar picker icons (toggle buttons that open a picker). Keyboard focus is shown with a visible outline. -->
    <Style x:Key="Button.HeaderIcon" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource AppBrush.HeaderForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppBrush.HeaderForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
