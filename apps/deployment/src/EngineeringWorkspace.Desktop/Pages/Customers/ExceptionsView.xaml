<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Customers.ExceptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Exceptions" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="An exception records that the customer is not required to meet a control. Active (approved, not expired) exceptions count as satisfied in every report." />
                <controls:CustomerSelector HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Exception" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" />
                <WrapPanel>
                    <StackPanel Width="260" Margin="0,0,12,6">
                        <TextBlock Text="Find Control" Style="{StaticResource Text.Label}" />
                        <controls:SearchBox Text="{Binding ControlSearch, Mode=TwoWay}" Placeholder="Search control ID or name" />
                    </StackPanel>
                    <StackPanel Width="420" Margin="0,0,12,6">
                        <TextBlock Text="Control" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding ControlOptionsView}" SelectedItem="{Binding Control}" DisplayMemberPath="Label" AutomationProperties.Name="Control" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,6">
                        <TextBlock Text="Status" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" AutomationProperties.Name="Status" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,6">
                        <TextBlock Text="Approved By" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding ApprovedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved by" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,6">
                        <TextBlock Text="Expires" Style="{StaticResource Text.Label}" />
                        <DatePicker SelectedDate="{Binding Expires}" AutomationProperties.Name="Expires" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Reason" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" AutomationProperties.Name="Reason" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save Exception" Command="{Binding SaveCommand}" />
                    <Button Content="New Exception" Command="{Binding NewCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <controls:ResizablePanel Header="Exceptions (select a row to edit)" PanelHeight="300">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="110" />
                        <DataGridTextColumn Header="Name" Binding="{Binding ControlName}" Width="2*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                        <DataGridTextColumn Header="Approved By" Binding="{Binding ApprovedBy}" Width="*" />
                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="Auto" />
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:ResizablePanel>
        </Border>
    </StackPanel>
</UserControl>
