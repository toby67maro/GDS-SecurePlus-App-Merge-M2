<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Assessments.AssessmentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assessments="clr-namespace:EngineeringWorkspace.Desktop.Pages.Assessments"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <UserControl.Resources>
        <Style x:Key="ScheduleStatus" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource AppBrush.TextSecondary}" />
            <Setter Property="FontWeight" Value="{DynamicResource AppFont.Weight.Medium}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource AppBrush.Information}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                    <Setter Property="Foreground" Value="{DynamicResource AppBrush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource AppBrush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldPanel" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Run Assessment -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Run Assessment" Style="{StaticResource Text.Heading3}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,8"
                           Text="Search for the customers to assess, tick them and select Assess Selected Now. Each assessment reads the tenant with the customer's app registration, evaluates the catalog controls and checks, and stores the results." />
                <controls:SearchBox Text="{Binding RunSearch, Mode=TwoWay}" Placeholder="Search customers, tenants or last assessment" MaxWidth="460" HorizontalAlignment="Left" />
                <controls:ResizablePanel Header="Customers" PanelHeight="200">
                    <DataGrid ItemsSource="{Binding CustomerChoicesView}" CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Select" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"
                                                  AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Last Assessment" Binding="{Binding LastAssessment}" Width="2*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
                <WrapPanel Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding ScanTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding SelectedScanType}"
                              Width="150" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Scan type"
                              ToolTip="Quick scan: users, groups, roles, licences and posture (minutes). In-depth scan: everything, including Intune devices and assignments." />
                    <Button Content="Scan Selected Now" Command="{Binding AssessSelectedCommand}" />
                    <Button Content="Select All Connected" Command="{Binding SelectAllCommand}" CommandParameter="all" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Clear" Command="{Binding SelectAllCommand}" CommandParameter="none" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Run Pending" Command="{Binding RunPendingCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Recurring Assessment -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Recurring Assessment" Style="{StaticResource Text.Heading3}" />
                <DockPanel Margin="0,2,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Register Background Runner" Command="{Binding RegisterBackgroundHostCommand}" Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding IsBackgroundHostRegistered, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Adds a task of your Windows account to Task Scheduler that runs due schedules every 5 minutes while you are signed in." />
                        <Button Content="Remove Background Runner" Command="{Binding RemoveBackgroundHostCommand}" Style="{StaticResource Button.Secondary}"
                                Visibility="{Binding IsBackgroundHostRegistered, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackgroundHostText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <!-- Editor: Frequency first; the fields that follow depend on it. -->
                <Border Style="{StaticResource Panel.Secondary}" DataContext="{Binding Editor}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" Margin="0,0,0,4" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource FieldPanel}" Width="150">
                                <TextBlock Text="Frequency" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Frequency" ToolTip="Choose Hourly, Daily, Weekly or Monthly first; the other fields depend on it." />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}" Width="230">
                                <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Label" IsTextSearchEnabled="True"
                                          TextSearch.TextPath="Label" AutomationProperties.Name="Customer" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}" Width="240">
                                <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Schedule name" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}" Width="170">
                                <TextBlock Text="Scan" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding ScanTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding ScanType}"
                                          AutomationProperties.Name="Scan type" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="Choose a frequency to see the schedule options." Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Visibility="{Binding HasFrequency, Converter={StaticResource InverseBoolToVisibility}}" />

                        <WrapPanel Visibility="{Binding HasFrequency, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <!-- Hourly -->
                            <StackPanel Style="{StaticResource FieldPanel}" Width="120" Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Every N Hours" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding IntervalHours, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Every N hours" ToolTip="1 to 23" />
                            </StackPanel>
                            <!-- Which Days (Hourly, Daily, Weekly) -->
                            <StackPanel Style="{StaticResource FieldPanel}" Width="230" Visibility="{Binding ShowWhichDays, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Which Days" Style="{StaticResource Text.Label}" />
                                <ContentControl Content="{Binding WhichDays}" Focusable="False" />
                            </StackPanel>
                            <!-- Monthly -->
                            <StackPanel Style="{StaticResource FieldPanel}" Width="230" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Which Months" Style="{StaticResource Text.Label}" />
                                <ContentControl Content="{Binding WhichMonths}" Focusable="False" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FieldPanel}" Visibility="{Binding IsMonthly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Run On" Style="{StaticResource Text.Label}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Day of Month" IsChecked="{Binding IsDayOfMonthMode, Mode=OneWay}" Margin="0,4,12,4" GroupName="MonthlyMode"
                                                 Checked="OnDayOfMonthChecked" />
                                    <RadioButton Content="Nth Weekday" IsChecked="{Binding IsNthWeekdayMode}" Margin="0,4,0,4" GroupName="MonthlyMode" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDayOfMonthMode, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox ItemsSource="{Binding DaysOfMonth}" SelectedItem="{Binding DayOfMonth}" DisplayMemberPath="Label" Width="110"
                                              AutomationProperties.Name="Day of month" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNthWeekdayMode, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBox ItemsSource="{Binding WeeksOfMonth}" SelectedItem="{Binding WeekOfMonth}" DisplayMemberPath="Label" Width="80" Margin="0,0,6,4"
                                              AutomationProperties.Name="Week of month" />
                                    <ComboBox ItemsSource="{Binding Weekdays}" SelectedItem="{Binding Weekday}" DisplayMemberPath="Label" Width="130"
                                              AutomationProperties.Name="Weekday" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Run Time (Daily, Weekly, Monthly) -->
                            <StackPanel Style="{StaticResource FieldPanel}" Width="100" Visibility="{Binding ShowRunTime, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Run Time" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding RunTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Run time" ToolTip="24-hour time, HH:mm" />
                            </StackPanel>
                            <!-- Weekly -->
                            <StackPanel Style="{StaticResource FieldPanel}" Width="120" Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Every N Weeks" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding IntervalWeeks, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Every N weeks" ToolTip="1 to 52" />
                            </StackPanel>
                            <!-- Hourly active window -->
                            <StackPanel Style="{StaticResource FieldPanel}" Visibility="{Binding IsHourly, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Content="Limit to Active Hours" IsChecked="{Binding UseWindow}" Margin="0,10,0,4" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding UseWindow, Converter={StaticResource BoolToVisibility}}">
                                    <TextBox Text="{Binding WindowStart, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Active window start" />
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                                    <TextBox Text="{Binding WindowEnd, UpdateSourceTrigger=PropertyChanged}" Width="70" AutomationProperties.Name="Active window end" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>

                        <ItemsControl ItemsSource="{Binding Messages}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Error}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="Next Run" Style="{StaticResource Text.Label}" />
                            <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding TimeZoneText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,8" />
                        <WrapPanel>
                            <Button Content="Save Schedule" Command="{Binding DataContext.SaveScheduleCommand, ElementName=Page}" />
                            <Button Content="New Schedule" Command="{Binding DataContext.NewScheduleCommand, ElementName=Page}" Style="{StaticResource Button.Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ScheduleMessage}" Visibility="{Binding ScheduleMessage, Converter={StaticResource TextToVisibility}}" TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- Filters -->
                <WrapPanel>
                    <StackPanel Style="{StaticResource FieldPanel}" Width="200">
                        <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding CustomerFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldPanel}" Width="150">
                        <TextBlock Text="Frequency" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding FrequencyFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldPanel}">
                        <TextBlock Text="Next Run" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding NextRunFrom}" Width="120" AutomationProperties.Name="Next run from" />
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker SelectedDate="{Binding NextRunTo}" Width="120" AutomationProperties.Name="Next run to" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldPanel}">
                        <TextBlock Text="Last Run" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding LastRunFrom}" Width="120" AutomationProperties.Name="Last run from" />
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker SelectedDate="{Binding LastRunTo}" Width="120" AutomationProperties.Name="Last run to" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource FieldPanel}" Width="260">
                        <TextBlock Text="Search" Style="{StaticResource Text.Label}" />
                        <controls:SearchBox Text="{Binding ScheduleSearch, Mode=TwoWay}" Placeholder="Search schedules" />
                    </StackPanel>
                    <Button Content="Clear Filters" Command="{Binding ClearScheduleFiltersCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <controls:ResizablePanel Header="{Binding ScheduleCountText}" PanelHeight="220">
                    <DataGrid ItemsSource="{Binding SchedulesView}" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="Auto" />
                            <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="Auto" />
                            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="Auto" />
                            <DataGridTextColumn Header="Next Run" Binding="{Binding NextRun}" Width="Auto" SortMemberPath="NextRunUtc" />
                            <DataGridTextColumn Header="Last Run" Binding="{Binding LastRun}" Width="Auto" SortMemberPath="LastRunUtc" />
                            <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource ScheduleStatus}" ToolTip="{Binding StatusDetail}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="State" Width="Auto" SortMemberPath="IsEnabled">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Toggle.Switch}"
                                                  AutomationProperties.Name="Schedule state" ToolTip="Turn the schedule on or off (saved immediately)" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#xE70F;" Style="{StaticResource Button.Icon}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                    Command="{Binding DataContext.EditScheduleCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE768;" Style="{StaticResource Button.Icon}" ToolTip="Run Now" AutomationProperties.Name="Run now"
                                                    Command="{Binding DataContext.RunScheduleNowCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                    Command="{Binding DataContext.DeleteScheduleCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>

        <!-- Assessments -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Heading3}"><Run Text="Assessments: " /><Run Text="{Binding CustomerName, Mode=OneWay}" /></TextBlock>
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox Content="Include Other Customers" IsChecked="{Binding IncludeOtherCustomers}" VerticalAlignment="Center" />
                    <Button Content="Request Assessment" Command="{Binding RequestAssessmentCommand}" Style="{StaticResource Button.Secondary}"
                            ToolTip="Record an assessment for the current customer and run it now (or when its tenant is connected)." />
                </WrapPanel>
                <StackPanel Visibility="{Binding IncludeOtherCustomers, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                    <WrapPanel>
                        <controls:SearchBox Text="{Binding OtherCustomerText, Mode=TwoWay}" Placeholder="Search customers to add" Width="260" Margin="0,0,8,4" />
                        <ComboBox ItemsSource="{Binding OtherCustomerOptionsView}" SelectedItem="{Binding OtherCustomer}" DisplayMemberPath="Name" Width="240" Margin="0,0,8,4"
                                  AutomationProperties.Name="Customer to add" />
                        <Button Content="&#xE710;" Style="{StaticResource Button.Icon}" Command="{Binding AddOtherCustomerCommand}" ToolTip="Add (+)" AutomationProperties.Name="Add customer"
                                BorderBrush="{DynamicResource AppBrush.InputBorder}" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding IncludedCustomers}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Button Content="&#xE738;" Style="{StaticResource Button.Icon}" ToolTip="Remove (−)" AutomationProperties.Name="Remove customer"
                                                Command="{Binding DataContext.RemoveOtherCustomerCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
        <assessments:AssessmentListView />
    </StackPanel>
</UserControl>
