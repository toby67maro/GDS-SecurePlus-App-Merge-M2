<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Assessments.AssessmentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Assessments" Style="{StaticResource Text.Heading3}" />
                <controls:ResizablePanel Header="Assessments Recorded in the Application Database" PanelHeight="240">
                    <DataGrid ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="Assessment" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="Auto" />
                            <DataGridTextColumn Header="Score %" Binding="{Binding Score, StringFormat={}{0:0.#}}" Width="Auto" />
                            <DataGridTextColumn Header="Passed" Binding="{Binding ControlsPassed}" Width="Auto" />
                            <DataGridTextColumn Header="Controls" Binding="{Binding ControlsTotal}" Width="Auto" />
                            <DataGridTextColumn Header="Results Saved" Binding="{Binding ResultsSaved}" Width="Auto" />
                            <DataGridTextColumn Header="Requested" Binding="{Binding RequestedAtUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" />
                            <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Findings" Style="{StaticResource Text.Heading3}" />
                <TextBlock Text="{Binding FindingsCaption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                <controls:ResizablePanel Header="Findings of the Selected Assessment" PanelHeight="320">
                    <DataGrid ItemsSource="{Binding Findings}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="*" />
                            <DataGridTextColumn Header="Control" Binding="{Binding Control}" Width="3*" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="Auto" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                            <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
