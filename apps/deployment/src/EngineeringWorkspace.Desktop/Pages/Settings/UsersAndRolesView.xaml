<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Settings.UsersAndRolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Users &amp; Roles" Style="{StaticResource Text.Heading3}" Margin="0" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Each person is added by Windows account (for example GDS\jsmith) with one role. The role decides what they can do in Secure Plus and in the shared database: only Engineers, Technicians/Deployers and Leads can use tenant credentials; only Sales, Leads and Managers see rates; only Leads manage users." />
                <TextBlock Text="{Binding YourAccess}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" IsEnabled="{Binding CanManage}">
            <StackPanel>
                <TextBlock Text="User" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" />
                <WrapPanel>
                    <StackPanel Width="240" Margin="0,0,12,6">
                        <TextBlock Text="Windows Account (DOMAIN\name)" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding WindowsAccount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Windows account" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,6">
                        <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                    </StackPanel>
                    <StackPanel Width="260" Margin="0,0,12,6">
                        <TextBlock Text="Sign-in Name (UPN)" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Upn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sign-in name" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,6">
                        <TextBlock Text="Role" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="Label" AutomationProperties.Name="Role" />
                    </StackPanel>
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" VerticalAlignment="Bottom" Margin="0,0,12,10" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save User" Command="{Binding SaveCommand}" />
                    <Button Content="Grant Database Access" Command="{Binding GrantCommand}" Style="{StaticResource Button.Secondary}"
                            ToolTip="Creates the SQL Server login and sets the database role. Needs the securityadmin server role; otherwise shows the script for your DBA." />
                    <Button Content="Show SQL Script" Command="{Binding ShowScriptCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="New User" Command="{Binding NewCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding HasScript, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy Script" Command="{Binding CopyScriptCommand}" Style="{StaticResource Button.Secondary}" />
                        <TextBlock Text="SQL Script for the SQL Server administrator" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Script, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="120" MaxHeight="260"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL script" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <controls:ResizablePanel Header="Users (select a row to edit)" PanelHeight="320">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Windows Account" Binding="{Binding Account}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Sign-in Name" Binding="{Binding Upn}" Width="*" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="Auto" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:ResizablePanel>
        </Border>
    </StackPanel>
</UserControl>
