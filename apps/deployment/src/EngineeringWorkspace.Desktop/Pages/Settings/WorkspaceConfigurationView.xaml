<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Settings.WorkspaceConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Workspace Configuration" Style="{StaticResource Text.Heading3}" />
                <TextBlock Text="{Binding StorageCaption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Button Content="Restart Now" Command="{Binding RestartCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Workspaces -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="New Workspace" Command="{Binding NewWorkspaceCommand}" />
                    <TextBlock Text="Workspaces" Style="{StaticResource Text.Heading3}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="A workspace groups the work for a customer. Give it a theme to tell customers apart at a glance: switching the workspace at the top of the window switches the theme." />
                <DataGrid ItemsSource="{Binding WorkspaceRows}" SelectedItem="{Binding SelectedWorkspace}" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Workspace" Binding="{Binding Name}" Width="1.5*" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="1.5*" />
                        <DataGridTextColumn Header="Theme" Binding="{Binding Theme}" Width="*" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" />
                        <DataGridTextColumn Header="" Binding="{Binding State}" Width="Auto" />
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#xE8E5;" Style="{StaticResource Button.Icon}" ToolTip="Open" AutomationProperties.Name="Open workspace"
                                                Command="{Binding DataContext.OpenWorkspaceCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE70F;" Style="{StaticResource Button.Icon}" ToolTip="Edit" AutomationProperties.Name="Edit workspace"
                                                Command="{Binding DataContext.EditWorkspaceCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE7B8;" Style="{StaticResource Button.Icon}" ToolTip="Archive" AutomationProperties.Name="Archive workspace"
                                                Command="{Binding DataContext.ArchiveWorkspaceCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="{DynamicResource AppBrush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                        Visibility="{Binding IsWorkspaceEditorOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding WorkspaceEditorTitle}" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Width="280" Margin="0,0,12,6">
                                <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name" />
                            </StackPanel>
                            <StackPanel Width="280" Margin="0,0,12,6">
                                <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding WorkspaceCustomer}" AutomationProperties.Name="Customer" />
                            </StackPanel>
                            <StackPanel Width="240" Margin="0,0,12,6">
                                <TextBlock Text="Theme" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding WorkspaceTheme}" AutomationProperties.Name="Theme" />
                            </StackPanel>
                            <StackPanel Width="420" Margin="0,0,12,6">
                                <TextBlock Text="Description" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding WorkspaceDescription, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox Content="Open This Workspace After Saving" IsChecked="{Binding OpenAfterSave}" />
                        <TextBlock Text="{Binding WorkspaceMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding WorkspaceMessage, Converter={StaticResource TextToVisibility}}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Save Workspace" Command="{Binding SaveWorkspaceCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelWorkspaceCommand}" Style="{StaticResource Button.Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Themes -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="New Theme" Command="{Binding NewThemeCommand}" />
                    <TextBlock Text="Themes" Style="{StaticResource Text.Heading3}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="The default theme applies to every workspace that has no theme of its own. Preview applies a theme on this computer only." />
                <DataGrid ItemsSource="{Binding ThemeRows}" SelectedItem="{Binding SelectedTheme}" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Theme" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="Auto" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                        <DataGridTextColumn Header="Workspaces" Binding="{Binding Workspaces}" Width="Auto" />
                        <DataGridTextColumn Header="" Binding="{Binding Default}" Width="Auto" />
                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="&#xE7B3;" Style="{StaticResource Button.Icon}" ToolTip="Preview" AutomationProperties.Name="Preview theme"
                                                Command="{Binding DataContext.PreviewThemeCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE734;" Style="{StaticResource Button.Icon}" ToolTip="Make Default" AutomationProperties.Name="Make default theme"
                                                Command="{Binding DataContext.SetDefaultThemeCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete theme"
                                                Command="{Binding DataContext.DeleteThemeCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="{DynamicResource AppBrush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                        Visibility="{Binding IsThemeEditorOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="New Theme" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Width="260" Margin="0,0,12,6">
                                <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Theme name" />
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,6">
                                <TextBlock Text="Mode" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}" AutomationProperties.Name="Mode" />
                            </StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,6">
                                <TextBlock Text="Primary Colour" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ThemePrimary, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Primary colour" />
                            </StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,6">
                                <TextBlock Text="Accent Colour" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ThemeAccent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Accent colour" />
                            </StackPanel>
                            <StackPanel Width="130" Margin="0,0,12,6">
                                <TextBlock Text="Header Colour" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ThemeHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Header colour" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,6">
                                <TextBlock Text="Menu Colour" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ThemeNavigation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Menu colour" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding ThemeMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Visibility="{Binding ThemeMessage, Converter={StaticResource TextToVisibility}}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Save Theme" Command="{Binding SaveThemeCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelThemeCommand}" Style="{StaticResource Button.Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource Text.Heading3}" />
                <TextBlock Text="{Binding LoadedCaption}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6" />
                <WrapPanel>
                    <controls:SearchBox Text="{Binding Search, Mode=TwoWay}" Placeholder="Search settings and values" Width="300" Margin="0,0,12,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="200" AutomationProperties.Name="Category" />
                    </StackPanel>
                    <CheckBox Content="Changed Only" IsChecked="{Binding ChangedOnly}" Margin="0,0,12,6" />
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Save Changes" Command="{Binding SaveCommand}" />
                    <Button Content="Discard Changes" Command="{Binding ResetCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Export JSON" Command="{Binding ExportCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Import JSON" Command="{Binding ImportCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <Border BorderBrush="{DynamicResource AppBrush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                        Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Import Preview" Style="{StaticResource Text.Label}" FontSize="{DynamicResource AppFont.Size.Heading3}" />
                        <TextBlock Text="{Binding PreviewCaption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Preview}" Height="240" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding File}" Width="Auto" />
                                <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="2*" />
                                <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" />
                                <DataGridTextColumn Header="Imported" Binding="{Binding Imported}" Width="*" />
                                <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Apply Changes" Command="{Binding ApplyImportCommand}" />
                            <Button Content="Cancel" Command="{Binding CancelImportCommand}" Style="{StaticResource Button.Secondary}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <controls:ResizablePanel Header="Settings" PanelHeight="480">
                    <DataGrid ItemsSource="{Binding RowsView}" IsReadOnly="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Setting" Binding="{Binding Setting}" Width="1.6*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Value" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0" AutomationProperties.Name="{Binding Setting}" ToolTip="{Binding Error}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Applies To" Binding="{Binding AppliesTo}" Width="Auto" IsReadOnly="True" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" IsReadOnly="True" />
                            <DataGridTextColumn Header="Last Changed" Binding="{Binding ChangedBy}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Problem" Binding="{Binding Error}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
