<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Settings.BaselineConfigurationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Baseline Configurations" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Active baselines define what assessment scores, Fleet View and the reports measure. Show Compliance adds a baseline to the customer panel below." />
                <WrapPanel>
                    <Button Content="Build New Baseline" Command="{Binding NewCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                <controls:ResizablePanel Header="Baselines" PanelHeight="220">
                    <DataGrid ItemsSource="{Binding Rows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Baseline" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                            <DataGridTextColumn Header="Controls" Binding="{Binding Controls}" Width="Auto" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" />
                            <DataGridTemplateColumn Header="Active" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Toggle.Switch}" AutomationProperties.Name="Active" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Show Compliance" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ShowCompliance, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" AutomationProperties.Name="Show compliance" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#xE70F;" Style="{StaticResource Button.Icon}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                    Command="{Binding DataContext.EditCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE8C8;" Style="{StaticResource Button.Icon}" ToolTip="Clone" AutomationProperties.Name="Clone"
                                                    Command="{Binding DataContext.CloneCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                    Command="{Binding DataContext.DeleteCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Heading3}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <StackPanel Width="320" Margin="0,0,12,6">
                        <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Baseline name" />
                    </StackPanel>
                    <StackPanel Width="520" Margin="0,0,12,6">
                        <TextBlock Text="Description" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Width="230" Margin="0,0,12,6">
                        <TextBlock Text="Frameworks" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding Frameworks}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="230" Margin="0,0,12,6">
                        <TextBlock Text="Compliance Standards" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding Standards}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="230" Margin="0,0,12,6">
                        <TextBlock Text="Experiences" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding Experiences}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,6">
                        <TextBlock Text="Policy Sets" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding PolicySets}" Focusable="False" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Controls and Policies" Style="{StaticResource Text.Label}" />
                <WrapPanel>
                    <controls:SearchBox Text="{Binding ControlSearch, Mode=TwoWay}" Placeholder="Search controls and policies" Width="300" Margin="0,0,12,6" />
                    <CheckBox Content="Selected Only" IsChecked="{Binding SelectedOnly}" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding ControlsView}" Height="240" IsReadOnly="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Id}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="Control / Policy" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding EditorMessage}" Visibility="{Binding EditorMessage, Converter={StaticResource TextToVisibility}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save Baseline" Command="{Binding SaveCommand}" />
                    <Button Content="Cancel" Command="{Binding CloseEditorCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Compliant at" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Thresholds}" SelectedItem="{Binding Threshold}" Width="70" AutomationProperties.Name="Compliance threshold" />
                        <TextBlock Text="% or more" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Customer Compliance" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <TextBlock Text="{Binding ComplianceCaption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                <controls:ResizablePanel Header="Customers" PanelHeight="260">
                    <DataGrid ItemsSource="{Binding Compliance}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="2*" />
                            <DataGridTextColumn Header="Assessed" Binding="{Binding Assessed}" Width="Auto" />
                            <DataGridTextColumn Header="Compliance" Binding="{Binding PercentText}" Width="Auto" SortMemberPath="Percent" />
                            <DataGridTextColumn Header="Satisfied" Binding="{Binding Satisfied}" Width="Auto" />
                            <DataGridTextColumn Header="Gaps" Binding="{Binding Gaps}" Width="Auto" />
                            <DataGridTextColumn Header="Not Evaluated" Binding="{Binding NotEvaluated}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
