<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Catalog.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding AssessmentText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,6" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Load Into Database" Command="{Binding SyncDatabaseCommand}" IsEnabled="{Binding CanSyncDatabase}"
                            Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                            ToolTip="Writes (or rewrites) every policy, setting, policy set, framework mapping and standard into the application database tables." />
                    <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                </DockPanel>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="0,0,10,6" />
                        </Style>
                    </WrapPanel.Resources>
                    <StackPanel Width="280">
                        <TextBlock Text="Search" Style="{StaticResource Text.Label}" />
                        <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="Search IDs, names, settings, values and descriptions"
                                            ToolTip="Search IDs, names, settings, values, descriptions, experience and pain points" />
                    </StackPanel>
                    <StackPanel Width="170">
                        <TextBlock Text="Kind" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
                    </StackPanel>
                    <StackPanel Width="230">
                        <TextBlock Text="Category" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsTextSearchEnabled="True" />
                    </StackPanel>
                    <StackPanel Width="150">
                        <TextBlock Text="Platform" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" />
                    </StackPanel>
                    <StackPanel Width="200">
                        <TextBlock Text="Baseline (Policy Set)" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding PolicySetOptions}" SelectedItem="{Binding PolicySet}" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="Severity" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" />
                    </StackPanel>
                    <StackPanel Width="120">
                        <TextBlock Text="Evaluation" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Evaluations}" SelectedItem="{Binding Evaluation}" />
                    </StackPanel>
                    <StackPanel Width="130">
                        <TextBlock Text="Result" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                    </StackPanel>
                    <StackPanel Width="240">
                        <TextBlock Text="Framework" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding FrameworkFilter}" Focusable="False" />
                    </StackPanel>
                </WrapPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Button.Secondary}" />
                        <TextBlock Text="Export:" VerticalAlignment="Center" Margin="8,0,6,8" />
                        <Button Content=".csv" Command="{Binding ExportCommand}" CommandParameter="Csv" Style="{StaticResource Button.Secondary}" />
                        <Button Content=".html" Command="{Binding ExportCommand}" CommandParameter="Html" Style="{StaticResource Button.Secondary}" />
                        <Button Content=".json" Command="{Binding ExportCommand}" CommandParameter="Json" Style="{StaticResource Button.Secondary}" />
                        <Button Content=".txt" Command="{Binding ExportCommand}" CommandParameter="Txt" Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                    <CheckBox Content="Golden Tenant Baseline Only" IsChecked="{Binding GoldenOnly}" VerticalAlignment="Center" />
                    <CheckBox Content="Show Variants" IsChecked="{Binding ShowVariants}" VerticalAlignment="Center"
                              ToolTip="Show alternative versions of a control (same policy number, different configuration)." />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Text.Secondary}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0">
                <controls:ResizablePanel Header="Controls (select a row for details; drag the grip or Expand for full screen)" PanelHeight="560" Margin="0">
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" CanUserSortColumns="True" CanUserResizeColumns="True"
                              CanUserReorderColumns="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="170" />
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90" />
                            <DataGridTextColumn Header="Control / Setting" Binding="{Binding Name}" Width="280" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="130" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="80" />
                            <DataGridTextColumn Header="User Impact" Binding="{Binding UserImpact}" Width="80" />
                            <DataGridTextColumn Header="Experience" Binding="{Binding Experience}" Width="240" />
                            <DataGridTextColumn Header="Pain Points" Binding="{Binding PainPoints}" Width="260" />
                            <DataGridTextColumn Header="Baselines" Binding="{Binding PolicySets}" Width="180" />
                            <DataGridTextColumn Header="Frameworks" Binding="{Binding Frameworks}" Width="260" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="200" />
                            <DataGridTextColumn Header="Evaluation" Binding="{Binding Evaluation}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize" />
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Control Details" Style="{StaticResource Text.Heading3}" />
                    <TextBlock Text="Select a control to see its description, Microsoft Graph request, remediation options and implementation details." Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Expander Header="Overview / Description" Style="{StaticResource Section.Expander}" IsExpanded="{Binding OverviewExpanded, Mode=TwoWay}">
                                <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                         MinHeight="0" Padding="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="Microsoft Graph Request" Style="{StaticResource Section.Expander}" IsExpanded="{Binding GraphExpanded, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="This control has no Microsoft Graph request body." Style="{StaticResource Text.Caption}"
                                               Visibility="{Binding GraphBody, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                                    <StackPanel Visibility="{Binding GraphBody, Converter={StaticResource TextToVisibility}}">
                                        <TextBox Text="{Binding GraphRequest, Mode=OneWay}" Style="{StaticResource Text.Code}" MaxHeight="60" />
                                        <controls:CodeView Code="{Binding GraphBody}" CodeLanguage="json" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Remediation Options" Style="{StaticResource Section.Expander}" IsExpanded="{Binding RemediationExpanded, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="No remediation content is available for this control." Style="{StaticResource Text.Caption}"
                                               Visibility="{Binding RemediationTabs.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                    <TabControl ItemsSource="{Binding RemediationTabs}" SelectedItem="{Binding SelectedRemediation}"
                                                Visibility="{Binding RemediationTabs.Count, Converter={StaticResource CountToVisibility}}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" />
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding GeneratedText}" Margin="0,4,0,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Caption}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppBrush.Warning}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <controls:CodeView Code="{Binding Content}" CodeLanguage="{Binding Language}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Implementation Details" Style="{StaticResource Section.Expander}" IsExpanded="{Binding ImplementationExpanded, Mode=TwoWay}">
                                <ItemsControl ItemsSource="{Binding ImplementationDetails}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                         MinHeight="0" Padding="0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
