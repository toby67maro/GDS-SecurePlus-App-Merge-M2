<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Advanced.DataExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Text="Read-only. Columns that hold secrets, passwords, tokens, certificates or key material are masked." />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Error}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0" MinHeight="520">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search tables" ToolTip="Search table names and purposes" />
                        <ComboBox ItemsSource="{Binding Schemas}" SelectedItem="{Binding SelectedSchema}" Margin="0,6,0,0" AutomationProperties.Name="Schema" />
                        <CheckBox Content="Only tables with rows" IsChecked="{Binding OnlyFilled}" Margin="0,6,0,6" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" Margin="0,8,0,0" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Purpose}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rows, StringFormat=N0}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedTable.Name}" Style="{StaticResource Text.Heading3}" />
                        <TextBlock Text="{Binding SelectedTable.Purpose}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <DockPanel Margin="0,6,0,6">
                            <Button DockPanel.Dock="Right" Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource Button.Secondary}" />
                            <Button DockPanel.Dock="Right" Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource Button.Secondary}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0" />
                            <Button DockPanel.Dock="Right" Content="Filter Rows" Command="{Binding SearchRowsCommand}" />
                            <TextBox Text="{Binding RowFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter rows" ToolTip="Text any column contains">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchRowsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" SelectionUnit="CellOrRowHeader"
                              ClipboardCopyMode="IncludeHeader" EnableColumnVirtualization="True" EnableRowVirtualization="True" MaxColumnWidth="420" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
