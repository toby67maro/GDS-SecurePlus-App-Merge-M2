<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Planning.SowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <controls:CustomerSelector Margin="0,0,16,6" />
                    <StackPanel Width="320" Margin="0,0,16,6">
                        <TextBlock Text="Template" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" AutomationProperties.Name="Template" />
                    </StackPanel>
                    <StackPanel Width="300" Margin="0,0,16,6">
                        <TextBlock Text="Project Plan" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" AutomationProperties.Name="Project plan" />
                        <TextBlock Text="Plans are built on Deployment &gt; Project Plan." Style="{StaticResource Text.Helper}" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Generate SOW" Command="{Binding GenerateCommand}" />
                    <Button Content="Save as HTML" Click="OnSaveHtml" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Save as Word" Click="OnSaveWord" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Copy Text" Click="OnCopy" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Expander Header="Template Editor" Style="{StaticResource Section.Expander}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,12,6">
                        <TextBlock Text="Code" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TemplateCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template code" />
                    </StackPanel>
                    <StackPanel Width="320" Margin="0,0,12,6">
                        <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name" />
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,6">
                        <TextBlock Text="Version" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding TemplateVersion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template version" />
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,6">
                        <TextBlock Text="Service Tier" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding TierOptions}" SelectedItem="{Binding TemplateTier}" AutomationProperties.Name="Service tier" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="New Template" Command="{Binding NewTemplateCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Duplicate" Command="{Binding DuplicateTemplateCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Save Template" Command="{Binding SaveTemplateCommand}" />
                    <Button Content="Delete Template" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource Button.Danger}" />
                </WrapPanel>
                <Grid Margin="0,8,0,0" MinHeight="380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Add" Command="{Binding AddSectionCommand}" Style="{StaticResource Button.Secondary}" />
                            <Button Content="Remove" Command="{Binding RemoveSectionCommand}" Style="{StaticResource Button.Secondary}" />
                            <Button Content="▲" Command="{Binding MoveSectionUpCommand}" Style="{StaticResource Button.Secondary}" ToolTip="Move up" />
                            <Button Content="▼" Command="{Binding MoveSectionDownCommand}" Style="{StaticResource Button.Secondary}" ToolTip="Move down" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Title" />
                    </DockPanel>
                    <StackPanel Grid.Column="2" DataContext="{Binding SelectedSection}">
                        <TextBlock Text="Section Title" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Section title" />
                        <CheckBox Content="Required" IsChecked="{Binding IsRequired}" Margin="0,6" />
                        <TextBlock Text="Content (use {{placeholders}})" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Section content" />
                    </StackPanel>
                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="Placeholders" Style="{StaticResource Text.Label}" />
                        <ListBox ItemsSource="{Binding PlaceholderText}" FontSize="{DynamicResource AppFont.Size.Small}" ToolTip="Copy a placeholder into the content (Ctrl+C)" />
                    </DockPanel>
                </Grid>
                <TextBlock Text="Deliverables ({{Deliverables}})" Style="{StaticResource Text.Label}" Margin="0,8,0,0" />
                <TextBox Text="{Binding Deliverables, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" AutomationProperties.Name="Deliverables" />
            </StackPanel>
        </Expander>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" controls:Motion.FadeIn="True">
            <StackPanel>
                <TextBlock Text="{Binding DocumentTitle}" Style="{StaticResource Text.Heading2}" />
                <ItemsControl ItemsSource="{Binding Preview}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading3}" Foreground="{DynamicResource AppBrush.Secondary}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
