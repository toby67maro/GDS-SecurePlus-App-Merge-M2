<Window x:Class="EngineeringWorkspace.Desktop.Pages.Planning.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:planning="clr-namespace:EngineeringWorkspace.Desktop.Pages.Planning"
        Title="{Binding Title}" Width="820" Height="720" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource AppBrush.ApplicationBackground}" Foreground="{DynamicResource AppBrush.TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <planning:TaskDetailView />
    </ScrollViewer>
</Window>
