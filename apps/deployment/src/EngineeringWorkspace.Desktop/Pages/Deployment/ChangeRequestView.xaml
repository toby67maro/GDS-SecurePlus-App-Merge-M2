<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Deployment.ChangeRequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="{x:Type StackPanel}">
            <Setter Property="Margin" Value="0,0,12,6" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Change Requests" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="Workflow: Draft → Submitted → Approved or Rejected → Scheduled → Completed. Approved and scheduled requests run on Change Execution." />
                <WrapPanel>
                    <controls:CustomerSelector Margin="0,0,12,6" />
                    <Button Content="New Change Request" Command="{Binding NewCommand}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                <controls:ResizablePanel Header="Change Requests of the Customer (select one to edit)" PanelHeight="200">
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="Auto" />
                            <DataGridTextColumn Header="Window" Binding="{Binding Window}" Width="*" />
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*" />
                            <DataGridTextColumn Header="Controls" Binding="{Binding Items}" Width="Auto" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" />
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete (Draft or Rejected only)" AutomationProperties.Name="Delete"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"><Run Text="Status: " /><Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <WrapPanel>
                    <StackPanel Style="{StaticResource Field}" Width="420">
                        <TextBlock Text="Title" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding RequestTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}" Width="120">
                        <TextBlock Text="Risk" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Risks}" SelectedItem="{Binding Risk}" AutomationProperties.Name="Risk" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}" Width="180">
                        <TextBlock Text="Requested By" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding RequestedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Requested by" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}" Width="180">
                        <TextBlock Text="Approved By" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding ApprovedBy, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Approved by" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}" Width="180">
                        <TextBlock Text="Owner" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Owner" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Window Start" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding WindowStartDate}" Width="120" AutomationProperties.Name="Window start date" />
                            <TextBox Text="{Binding WindowStartTime, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0" AutomationProperties.Name="Window start time" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Window End" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding WindowEndDate}" Width="120" AutomationProperties.Name="Window end date" />
                            <TextBox Text="{Binding WindowEndTime, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="6,0,0,0" AutomationProperties.Name="Window end time" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding RequestDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Description" />
                        <TextBlock Text="Impact" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Impact, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Impact" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Rollback Plan" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding RollbackPlan, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Rollback plan" />
                        <TextBlock Text="Decision Note" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding DecisionNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Decision note" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Controls and Policies Changed" Style="{StaticResource Text.Label}" Margin="0,10,0,4" />
                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,4,0,0">
                    <controls:SearchBox Text="{Binding ControlSearch, Mode=TwoWay}" Placeholder="Search controls and policies" Width="300" Margin="0,0,12,6" />
                    <CheckBox Content="Selected Only" IsChecked="{Binding SelectedOnly}" />
                    <Button Content="Add Roadmap Phase 1 Gaps" Command="{Binding AddRoadmapGapsCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding ControlsView}" Height="220" IsReadOnly="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Id}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="Control / Policy" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding EditorMessage}" Visibility="{Binding EditorMessage, Converter={StaticResource TextToVisibility}}" Style="{StaticResource Text.Error}" Margin="0,6,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}" />
                    <ItemsControl ItemsSource="{Binding NextStatuses}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.MoveToCommand, ElementName=Page}" CommandParameter="{Binding}" Style="{StaticResource Button.Secondary}">
                                    <TextBlock><Run Text="Move to " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <Expander Header="History" Style="{StaticResource Section.Expander}" Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding History}" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding ChangedAtUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" />
                            <DataGridTextColumn Header="Who" Binding="{Binding ChangedBy}" Width="Auto" />
                            <DataGridTextColumn Header="Change" Binding="{Binding Property}" Width="Auto" />
                            <DataGridTextColumn Header="From" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="To" Binding="{Binding NewValue}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" DataContext="{Binding Templates}">
            <Expander Header="Change Request Templates" Style="{StaticResource Section.Expander}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,6"
                               Text="Each customer has its own template: sections, wording, fields, approval text and the approval email. Start from a global template (the GDS default always exists), edit the customer's copy, or save it as a new global template for other customers. Global changes are never applied to a customer's copy automatically." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="This Customer's Templates" Style="{StaticResource Text.Label}" />
                            <DataGrid ItemsSource="{Binding CustomerTemplates}" SelectedItem="{Binding SelectedCustomerTemplate}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" />
                                    <DataGridTextColumn Header="From" Binding="{Binding Source}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Global Templates" Style="{StaticResource Text.Label}" />
                            <DataGrid ItemsSource="{Binding GlobalTemplates}" SelectedItem="{Binding SelectedGlobalTemplate}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Use for This Customer" Command="{Binding UseGlobalCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Template Name" Style="{StaticResource Text.Label}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name" />
                    <TextBlock Text="Sections (each starts with ## Title)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding SectionsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="320"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Sections" />
                    <TextBlock Text="Fields to Complete (comma-separated)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding FieldsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fields" />
                    <TextBlock Text="Approval Text" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding ApprovalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" AutomationProperties.Name="Approval text" />
                    <TextBlock Text="Approval Email Subject" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email subject" />
                    <TextBlock Text="Approval Email Body" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding EmailBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Email body" />
                    <TextBlock Text="{Binding PlaceholderHelp}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Save Template" Command="{Binding SaveCommand}" />
                        <TextBox Text="{Binding GlobalName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="12,0,6,0" VerticalContentAlignment="Center"
                                 ToolTip="Name for the global template" AutomationProperties.Name="Global template name" />
                        <Button Content="Save as Global" Command="{Binding SaveAsGlobalCommand}" Style="{StaticResource Button.Secondary}" />
                        <Button Content="Delete Template" Command="{Binding DeleteCommand}" Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" />
                        <Button Content="Preview Approval Email" Command="{Binding DataContext.PreviewApprovalEmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Button.Secondary}" Margin="12,0,0,0" ToolTip="Fill the template from the selected change request and copy the email for Outlook" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}" />
                    <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                             Visibility="{Binding Preview, Converter={StaticResource TextToVisibility}}" AutomationProperties.Name="Approval email preview" />
                </StackPanel>
            </Expander>
        </Border>
    </StackPanel>
</UserControl>
