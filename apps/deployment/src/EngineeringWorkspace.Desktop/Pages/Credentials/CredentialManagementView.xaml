<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Credentials.CredentialManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:credentials="clr-namespace:EngineeringWorkspace.Desktop.Pages.Credentials">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <credentials:OrganizationKeyPanelView DataContext="{Binding OrganizationKey}" />
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Stored Credentials" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Text.Caption}">
                    <Run Text="Secret Store: " /><Run Text="{Binding SecretStoreName, Mode=OneWay}" FontWeight="{DynamicResource AppFont.Weight.Medium}" />
                    <Run Text=" | " /><Run Text="{Binding ExpirationPolicy, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Text.Caption}" Text="Secrets are write-only: they are never shown, exported or logged. Tenant secrets are stored in the database encrypted with the organization key; the database connection's own secrets stay on this computer, protected by Windows DPAPI." />
                <DataGrid ItemsSource="{Binding Credentials}" SelectedItem="{Binding Selected}" Margin="0,12,0,8" MinHeight="160" MaxHeight="360">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding CredentialType}" Width="*" />
                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="Auto" />
                        <DataGridTextColumn Header="Secret" Binding="{Binding Secret}" Width="Auto" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" Width="*" />
                        <DataGridTextColumn Header="Tenant" Binding="{Binding Tenant}" Width="*" />
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" />
                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" />
                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpirationDateUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" />
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Tag="{Binding Status}" Style="{StaticResource Text.State}" ToolTip="{Binding StatusMessage}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel>
                    <Button Content="Validate" Command="{Binding ValidateCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Button.Danger}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Add Credential" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Display Name" />
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Display name" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Type" />
                    <ComboBox ItemsSource="{Binding CredentialTypes}" SelectedItem="{Binding NewCredentialType}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Secret Reference (optional; generated from the name when empty)" />
                    <TextBox Text="{Binding NewSecretReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Secret reference" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Expiration (yyyy-MM-dd, optional)" />
                    <TextBox Text="{Binding NewExpiration, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Customer ID (optional)" />
                    <TextBox Text="{Binding NewCustomerId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Tenant ID (optional)" />
                    <TextBox Text="{Binding NewTenantId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Secret (write-only)" />
                    <PasswordBox x:Name="NewSecretBox" PasswordChanged="OnNewSecretChanged" AutomationProperties.Name="New secret" />
                    <Button Content="Add" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Replace Selected Secret" Style="{StaticResource Text.Heading3}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Selected.DisplayName, TargetNullValue='Select a credential in the table.'}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="New Expiration (yyyy-MM-dd, optional)" />
                    <TextBox Text="{Binding ReplacementExpiration, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="New Secret (write-only)" />
                    <PasswordBox x:Name="ReplacementSecretBox" PasswordChanged="OnReplacementSecretChanged" AutomationProperties.Name="Replacement secret" />
                    <Button Content="Replace" Command="{Binding ReplaceCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
