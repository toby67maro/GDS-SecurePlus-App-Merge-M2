<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Credentials.OrganizationKeyPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Organization Key" Style="{StaticResource Text.Heading3}" />
        <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
        <WrapPanel Margin="0,8,0,0">
            <Button Content="Create Organization Key" Command="{Binding CreateCommand}" Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Show Key for Another Computer" Command="{Binding ShowCommand}" Style="{StaticResource Button.Secondary}"
                    Visibility="{Binding CanShow, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Check Again" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" />
        </WrapPanel>
        <StackPanel Visibility="{Binding CanEnter, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
            <TextBlock Text="Organization Key" Style="{StaticResource Text.Label}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Use This Key" Command="{Binding EnterCommand}" Margin="8,0,0,0" />
                <TextBox Text="{Binding EnteredKey, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Organization key" />
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasShownKey, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
            <TextBlock Text="Key (keep it secret)" Style="{StaticResource Text.Label}" />
            <TextBox Text="{Binding ShownKey, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Organization key" />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="Copy" Command="{Binding CopyCommand}" />
                <Button Content="Save to File" Command="{Binding SaveCommand}" Style="{StaticResource Button.Secondary}" />
                <Button Content="Hide" Command="{Binding HideCommand}" Style="{StaticResource Button.Secondary}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Message, Converter={StaticResource TextToVisibility}}" />
    </StackPanel>
</UserControl>
