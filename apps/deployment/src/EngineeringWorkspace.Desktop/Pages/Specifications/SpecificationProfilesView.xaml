<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Specifications.SpecificationProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Specification Profiles" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,6"
                           Text="A specification names the target experiences, frameworks and compliance standards, the controls required, the requirements that satisfy them, and the policy sets and policies used. Standard specifications are not tied to a customer; tailored ones are assigned to one." />
                <WrapPanel>
                    <StackPanel Width="280" Margin="0,0,12,6">
                        <TextBlock Text="Search" Style="{StaticResource Text.Label}" />
                        <controls:SearchBox Text="{Binding Search, Mode=TwoWay}" Placeholder="Search specifications or customers" />
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,12,6">
                        <TextBlock Text="Customer" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding CustomerFilter}" Focusable="False" />
                    </StackPanel>
                    <Button Content="Build New Specification" Command="{Binding NewCommand}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <controls:ResizablePanel Header="Specifications" PanelHeight="260">
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Customers" Binding="{Binding Customers}" Width="2*" />
                            <DataGridTextColumn Header="Controls" Binding="{Binding Controls}" Width="Auto" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="Auto" />
                            <DataGridTemplateColumn Header="Actions" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="&#xE70F;" Style="{StaticResource Button.Icon}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                    Command="{Binding DataContext.EditCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE8C8;" Style="{StaticResource Button.Icon}" ToolTip="Clone" AutomationProperties.Name="Clone"
                                                    Command="{Binding DataContext.CloneCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                            <Button Content="&#xE74D;" Style="{StaticResource Button.Icon}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                    Command="{Binding DataContext.DeleteCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Selected Specification:" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <ComboBox ItemsSource="{Binding AssignOptions}" SelectedItem="{Binding AssignCustomer}" DisplayMemberPath="Label" Width="240" Margin="0,0,8,8"
                              AutomationProperties.Name="Customer to assign" />
                    <Button Content="Assign to Customer" Command="{Binding AssignCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Unassign From Customer" Command="{Binding UnassignCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Text.Heading3}" />
                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <Expander Header="1. Name and Status" Style="{StaticResource Section.Expander}" IsExpanded="True" Margin="0,8,0,8">
                    <WrapPanel>
                        <StackPanel Width="320" Margin="0,0,12,6">
                            <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Specification name" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,6">
                            <TextBlock Text="Status" Style="{StaticResource Text.Label}" />
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" AutomationProperties.Name="Status" />
                        </StackPanel>
                        <CheckBox Content="Standard (not tailored to one customer)" IsChecked="{Binding IsStandard}" VerticalAlignment="Bottom" />
                        <StackPanel Width="660" Margin="0,0,12,6">
                            <TextBlock Text="Description" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="Description" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
                <Expander Header="2. Experiences, Frameworks and Compliance Standards" Style="{StaticResource Section.Expander}" IsExpanded="True">
                    <WrapPanel>
                        <StackPanel Width="240" Margin="0,0,12,6">
                            <TextBlock Text="Experiences" Style="{StaticResource Text.Label}" />
                            <ContentControl Content="{Binding Experiences}" Focusable="False" />
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,12,6">
                            <TextBlock Text="Frameworks" Style="{StaticResource Text.Label}" />
                            <ContentControl Content="{Binding Frameworks}" Focusable="False" />
                        </StackPanel>
                        <StackPanel Width="260" Margin="0,0,12,6">
                            <TextBlock Text="Compliance Standards" Style="{StaticResource Text.Label}" />
                            <ContentControl Content="{Binding Standards}" Focusable="False" />
                        </StackPanel>
                    </WrapPanel>
                </Expander>
                <Expander Header="3. Policy Sets and Controls" Style="{StaticResource Section.Expander}" IsExpanded="True">
                    <StackPanel>
                        <WrapPanel>
                            <StackPanel Width="300" Margin="0,0,12,6">
                                <TextBlock Text="Policy Sets" Style="{StaticResource Text.Label}" />
                                <ContentControl Content="{Binding PolicySets}" Focusable="False" />
                            </StackPanel>
                            <Button Content="Add Suggested Controls" Command="{Binding AddSuggestedControlsCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom"
                                    ToolTip="Select the controls of the chosen policy sets, and the policies and checks mapped to the chosen frameworks, standards and experiences." />
                            <Button Content="Clear Controls" Command="{Binding ClearControlsCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom" />
                        </WrapPanel>
                        <WrapPanel>
                            <controls:SearchBox Text="{Binding ControlSearch, Mode=TwoWay}" Placeholder="Search controls" Width="300" Margin="0,0,12,6" />
                            <CheckBox Content="Selected Controls Only" IsChecked="{Binding SelectedControlsOnly}" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding ControlsView}" Height="300" EnableRowVirtualization="True" IsReadOnly="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Select" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" AutomationProperties.Name="{Binding Id}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="Control" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
                <Expander Header="4. Requirements" Style="{StaticResource Section.Expander}" IsExpanded="True">
                    <StackPanel Width="420" HorizontalAlignment="Left">
                        <TextBlock Text="Requirements that the selected controls satisfy (from the frameworks and standards)." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        <ContentControl Content="{Binding Requirements}" Focusable="False" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding EditorMessage}" Visibility="{Binding EditorMessage, Converter={StaticResource TextToVisibility}}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Save Specification" Command="{Binding SaveCommand}" />
                    <Button Content="Cancel" Command="{Binding CloseEditorCommand}" Style="{StaticResource Button.Secondary}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
