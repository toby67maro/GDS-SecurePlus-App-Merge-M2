<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Insights.RoadmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Remediation Roadmap" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <controls:CustomerSelector Margin="0,0,12,6" />
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Text="Start Date" Style="{StaticResource Text.Label}" />
                        <DatePicker SelectedDate="{Binding StartDate}" Width="140" AutomationProperties.Name="Start date" ToolTip="The schedule starts on this date (moved to the next work day)" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6" Width="110">
                        <TextBlock Text="Hours per Day" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding HoursPerDay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hours per day" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6" Width="110">
                        <TextBlock Text="Engineers" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Engineers, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Engineers" ToolTip="People working in parallel" />
                    </StackPanel>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Width="160" Margin="0,0,12,6">
                        <TextBlock Text="Phase" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding PhaseFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,6">
                        <TextBlock Text="Severity" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding SeverityFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,12,6">
                        <TextBlock Text="Status" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding StatusFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="190" Margin="0,0,12,6">
                        <TextBlock Text="Solution Area" Style="{StaticResource Text.Label}" />
                        <ContentControl Content="{Binding AreaFilter}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Width="260" Margin="0,0,12,6">
                        <TextBlock Text="Search" Style="{StaticResource Text.Label}" />
                        <controls:SearchBox Text="{Binding Search, Mode=TwoWay}" Placeholder="Search controls" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="Timeline" IsChecked="{Binding ShowTimeline}" Margin="0,0,12,0" />
                    <CheckBox Content="Charts" IsChecked="{Binding ShowCharts}" Margin="0,0,12,0" />
                    <CheckBox Content="Phase lists" IsChecked="{Binding ShowGrid}" Margin="0,0,12,0" />
                </WrapPanel>
                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding OrderingText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding EmptyText}" Visibility="{Binding EmptyText, Converter={StaticResource TextToVisibility}}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <controls:KpiPanel ItemsSource="{Binding Kpis}" />

        <StackPanel Visibility="{Binding ShowTimeline, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="0,4,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider Minimum="12" Maximum="160" Value="{Binding Zoom}" Width="160" VerticalAlignment="Center" AutomationProperties.Name="Timeline zoom" />
                    <Button Content="Save Timeline Image" Click="OnSaveTimelineImage" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Flow Timeline" Style="{StaticResource Text.Heading2}" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding TimelineModes}" SelectedItem="{Binding TimelineMode}" Width="240" Margin="12,0,0,0" AutomationProperties.Name="Timeline shows" />
            </DockPanel>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Work weeks run left to right (Monday to Friday). Arrows go from work that must be done first to the work that depends on it. Colours: red Phase 1, orange Phase 2, blue Phase 3, grey Phase 4. Hover to highlight a box's arrows; click for details." />
            <controls:FlowTimeline x:Name="TimelineControl" Nodes="{Binding Timeline}" StartDate="{Binding StartDate}" HoursPerDay="{Binding HoursPerDay}" PixelsPerDay="{Binding Zoom}"
                                   Command="{Binding ShowDetailCommand}" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource Text.Heading3}" />
                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <WrapPanel Visibility="{Binding ShowCharts, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
            <controls:DonutChart Title="Hours by Phase (click to break down)" ItemsSource="{Binding HoursByPhase}" CenterText="{Binding TotalHoursText}" CenterCaption="of work" ValueFormat="N1"
                                 Command="{Binding ShowDetailCommand}" />
            <controls:DonutChart Title="Items by Severity (click for solution areas)" ItemsSource="{Binding ItemsBySeverity}" InnerRadiusRatio="0" Command="{Binding ShowDetailCommand}" />
            <controls:LineChart Title="Value Delivered by Week (%)" ItemsSource="{Binding ValueBurnUp}" Maximum="100" ValueFormat="0'%'" MinWidth="420"
                                Command="{Binding ShowDetailCommand}" />
        </WrapPanel>

        <StackPanel Visibility="{Binding ShowGrid, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="0,8,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Expand All" Command="{Binding ExpandAllCommand}" Style="{StaticResource Button.Secondary}" />
                    <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" Style="{StaticResource Button.Secondary}" />
                </StackPanel>
                <TextBlock Text="Phases" Style="{StaticResource Text.Heading2}" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Phases}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Header="{Binding Header}" Style="{StaticResource Section.Expander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="No items in this phase." Style="{StaticResource Text.Caption}"
                                           Visibility="{Binding Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                                <DataGrid ItemsSource="{Binding Rows}" MaxHeight="420" Visibility="{Binding Count, Converter={StaticResource CountToVisibility}}" CanUserReorderColumns="True"
                                          CanUserSortColumns="True" ClipboardCopyMode="IncludeHeader">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="Auto" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" />
                                        <DataGridTextColumn Header="Control" Binding="{Binding Name}" Width="3*" />
                                        <DataGridTextColumn Header="Work Package" Binding="{Binding PackageName}" Width="1.5*" />
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                                        <DataGridTextColumn Header="Hours" Binding="{Binding Hours}" Width="Auto" />
                                        <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="Auto" />
                                        <DataGridTextColumn Header="Finish" Binding="{Binding Finish}" Width="Auto" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="Auto" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="Auto" />
                                        <DataGridTextColumn Header="Solution Area" Binding="{Binding SolutionArea}" Width="*" />
                                        <DataGridTextColumn Header="Depends On" Binding="{Binding DependsOn}" Width="1.5*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
