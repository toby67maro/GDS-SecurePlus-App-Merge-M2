<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Insights.HeatMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Heat Map" Style="{StaticResource Text.Label}" />
                <ListBox ItemsSource="{Binding MapKinds}" SelectedItem="{Binding SelectedKind}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Heat map">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Padding="10,4" ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SelectedKind.Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Visibility="{Binding IsCompliance, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <controls:ExportButtons DockPanel.Dock="Right" Command="{Binding ExportCommand}" VerticalAlignment="Top" />
                    <TextBlock Text="Compliance Heat Map" Style="{StaticResource Text.Heading3}" Margin="0" />
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="0,0,12,6" />
                        </Style>
                    </WrapPanel.Resources>
                    <controls:CustomerSelector Margin="0,0,12,6" />
                    <StackPanel Width="190">
                        <TextBlock Text="Rows" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Dimensions}" SelectedItem="{Binding RowDimension}" AutomationProperties.Name="Row dimension" />
                    </StackPanel>
                    <StackPanel Width="190">
                        <TextBlock Text="Columns" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Dimensions}" SelectedItem="{Binding ColumnDimension}" AutomationProperties.Name="Column dimension" />
                    </StackPanel>
                    <StackPanel Width="170">
                        <TextBlock Text="Colour By" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" AutomationProperties.Name="Colour by" />
                    </StackPanel>
                    <StackPanel Width="200">
                        <TextBlock Text="Scope" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" DisplayMemberPath="Label" AutomationProperties.Name="Scope" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Assessment Date" Style="{StaticResource Text.Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <DatePicker SelectedDate="{Binding FromDate}" Width="120" AutomationProperties.Name="Assessment date from" />
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="120" AutomationProperties.Name="Assessment date to" />
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Filters" Style="{StaticResource Text.Label}" />
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding ActiveFilters}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,6" Width="210">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource Button.Icon}" ToolTip="Remove this filter"
                                                AutomationProperties.Name="Remove filter" Command="{Binding DataContext.RemoveFilterCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ContentControl Content="{Binding Filter}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <ComboBox ItemsSource="{Binding AvailableFilters}" SelectedItem="{Binding FilterToAdd}" Width="180" AutomationProperties.Name="Filter to add" Margin="0,0,6,0" />
                        <Button Content="Add Filter" Command="{Binding AddFilterCommand}" Style="{StaticResource Button.Secondary}" Margin="0" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasMap, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Legend}" Focusable="False" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Border Width="18" Height="12" Background="{Binding Fill}" CornerRadius="2" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="230" />
                            <ItemsControl ItemsSource="{Binding ColumnHeaders}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Width="96" Margin="1,0" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Bottom"
                                                   FontWeight="{DynamicResource AppFont.Weight.Medium}" Style="{StaticResource Text.Caption}" ToolTip="{Binding}" MaxHeight="64" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Label}" Width="230" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Label}" />
                                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="96" Height="32" Margin="1,0" Padding="0" Background="{Binding Fill}" BorderBrush="Transparent" Foreground="{Binding Foreground}"
                                                            Content="{Binding Text}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding ToolTip}"
                                                            Command="{Binding DataContext.SelectCellCommand, ElementName=Page}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasMap, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding DrillDownCaption}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                <controls:ResizablePanel Header="Controls Behind the Selected Cell" PanelHeight="280">
                    <DataGrid ItemsSource="{Binding DrillDown}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" />
                            <DataGridTextColumn Header="Control" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                            <DataGridTextColumn Header="Solution Area" Binding="{Binding SolutionArea}" Width="*" />
                            <DataGridTextColumn Header="Experience" Binding="{Binding Experience}" Width="*" />
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:ResizablePanel>
            </StackPanel>
        </Border>
        </StackPanel>
        <StackPanel Visibility="{Binding IsOtherMap, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Visibility="{Binding IsOtherMap, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel>
                    <controls:CustomerSelector Margin="0,0,12,6" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </WrapPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" Visibility="{Binding OtherLoading, Converter={StaticResource BoolToVisibility}}" />
            <controls:HeatGrid Title="{Binding SelectedKind.Name}" Cells="{Binding OtherCells}" HighIsGood="{Binding SelectedKind.HighIsGood}"
                               LegendText="{Binding SelectedKind.Legend}" Command="{Binding SelectOtherCellCommand}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding OtherCaption}" Style="{StaticResource Text.Heading3}" />
                    <TextBlock Text="{Binding OtherDetailText}" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding OtherDetail}" MaxHeight="420" Margin="0,6,0,0" Visibility="{Binding OtherDetail.Count, Converter={StaticResource CountToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110" />
                            <DataGridTextColumn Header="Control" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="Auto" />
                            <DataGridTextColumn Header="Effort" Binding="{Binding Effort}" Width="Auto" />
                            <DataGridTextColumn Header="Solution Area" Binding="{Binding SolutionArea}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
