<UserControl x:Class="EngineeringWorkspace.Desktop.Pages.Experience.ExperienceConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EngineeringWorkspace.Desktop.Controls"
             x:Name="Page">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <WrapPanel>
                    <controls:CustomerSelector Margin="0,0,16,6" />
                    <StackPanel Margin="0,0,16,6" Width="260">
                        <TextBlock Text="Experience For" Style="{StaticResource Text.Label}" />
                        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" AutomationProperties.Name="Experience for" />
                        <TextBlock Text="{Binding ScopeDetail}" Style="{StaticResource Text.Helper}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Width="260">
                        <TextBlock Text="Start From Profile" Style="{StaticResource Text.Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyProfileCommand}" Style="{StaticResource Button.Secondary}" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Experience profile" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedProfile.Description}" Style="{StaticResource Text.Helper}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Compliance Targets" Style="{StaticResource Text.Label}" Margin="0,6,0,2" />
                <ItemsControl ItemsSource="{Binding Frameworks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Description}" Margin="0,0,6,6" Padding="10,3" Cursor="Hand" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Save Experience" Command="{Binding SaveCommand}" />
                    <Button Content="Import EaaS Form Results…" Click="OnImportFormResults" Style="{StaticResource Button.Secondary}"
                            ToolTip="Create user groups, compliance targets and experience answers from the GDS EaaS discovery and design-workshop forms (customer configuration JSON)" />
                    <Button Content="Reset to Inherited" Command="{Binding ResetToInheritedCommand}" Style="{StaticResource Button.Secondary}"
                            ToolTip="Clear this scope's own answers so it follows its profile and All Users again" />
                    <TextBlock Text="Unsaved changes" Foreground="{DynamicResource AppBrush.Warning}" VerticalAlignment="Center" Margin="8,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <WrapPanel>
            <controls:GaugeChart Title="Security" Value="{Binding SecurityScore}" Subtitle="How well protected this experience is" Width="230" />
            <Border Style="{StaticResource Card}" Width="230" Margin="0,0,10,10" controls:Motion.HoverLift="True">
                <StackPanel>
                    <TextBlock Text="User Friction" Style="{StaticResource Text.Heading3}" />
                    <TextBlock Text="{Binding FrictionScore, StringFormat={}{0:0} / 100}" Style="{StaticResource Text.KpiValue}" />
                    <TextBlock Text="Lower is smoother: fewer prompts, blocks and extra steps." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConflictCount, StringFormat={}{0} conflict(s) with compliance targets}" Foreground="{DynamicResource AppBrush.Error}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <controls:HorizontalBarChart Title="Friction by Solution (click for detail)" ItemsSource="{Binding SolutionFriction}" Maximum="100" LabelWidth="170" MinWidth="520" />
        </WrapPanel>

        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding Name}" Style="{StaticResource Section.Expander}" IsExpanded="False">
                        <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Heading3}" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Row" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,4" BorderBrush="{DynamicResource AppBrush.Divider}">
                                                            <StackPanel>
                                                                <RadioButton GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected}">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="{DynamicResource AppFont.Weight.Medium}" />
                                                                </RadioButton>
                                                                <TextBlock Text="{Binding UserExperience}" TextWrapping="Wrap" Margin="22,2,0,0" />
                                                                <TextBlock Text="{Binding Scores}" Style="{StaticResource Text.Caption}" Margin="22,2,0,0" />
                                                                <TextBlock Text="{Binding Configuration, StringFormat=How we build it: {0}}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="22,2,0,0"
                                                                           Visibility="{Binding HasConfiguration, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Text="{Binding FrameworkText}" TextWrapping="Wrap" Margin="22,2,0,0" Foreground="{DynamicResource AppBrush.Warning}"
                                                                           Visibility="{Binding FrameworkText, Converter={StaticResource TextToVisibility}}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AppBrush.Primary}" />
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppBrush.SurfaceSecondary}" />
                                                                <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AppBrush.Error}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
