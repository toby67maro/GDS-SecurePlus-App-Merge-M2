<Window x:Class="EngineeringWorkspace.Desktop.Bootstrap.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Plus Agent Cannot Start" Width="900" Height="600" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBrush.ApplicationBackground}" Foreground="{DynamicResource AppBrush.TextPrimary}"
        FontFamily="{DynamicResource AppFont.Family}" FontSize="{DynamicResource AppFont.Size.Base}">
    <DockPanel Margin="{DynamicResource AppSpacing.XL}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Heading2}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="Fix the items below, then start the application again. Secret values are never shown." />
            <TextBlock x:Name="DiagnosticPath" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Click="OnClose" Margin="0,12,0,0" />
        <ListBox x:Name="Problems" BorderBrush="{DynamicResource AppBrush.Border}" Background="{DynamicResource AppBrush.SurfaceBackground}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" MaxWidth="820" Foreground="{DynamicResource AppBrush.TextPrimary}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
