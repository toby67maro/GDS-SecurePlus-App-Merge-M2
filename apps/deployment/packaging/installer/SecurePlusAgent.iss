; Inno Setup script for the GDS Secure Plus agent Windows installer (Setup.exe).
; Installs the self-contained application to Program Files, adds Start menu (and optional desktop) shortcuts and
; registers "GDS Secure Plus agent" in Programs and Features (appwiz.cpl) with an uninstaller.
; Per-user configuration and data stay in %LOCALAPPDATA%\Global Data Systems\Secure Plus Agent and survive
; upgrades and uninstall.
;
; Built by scripts/package-windows.ps1:
;   ISCC.exe /DAppVersion=1.1.0 /DSourceDir=<publish folder> /DOutputDir=<artifacts> packaging\installer\SecurePlusAgent.iss

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef NumericVersion
  #define NumericVersion AppVersion
#endif
#ifndef SourceDir
  #define SourceDir "..\..\artifacts\publish\win-x64"
#endif
#ifndef OutputDir
  #define OutputDir "..\..\artifacts"
#endif

#define ProductName "GDS Secure Plus agent"
#define Publisher "Global Data Systems"
#define ExeName "EngineeringWorkspace.Desktop.exe"

[Setup]
; The AppId identifies the product for upgrades and uninstall; never change it.
AppId={{2FDF5294-A682-42E9-A459-AB3760898C89}
AppName={#ProductName}
AppVersion={#AppVersion}
AppVerName={#ProductName} {#AppVersion}
AppPublisher={#Publisher}
AppCopyright=Copyright (C) {#Publisher}
VersionInfoVersion={#NumericVersion}.0
VersionInfoProductName={#ProductName}
VersionInfoDescription={#ProductName} Setup
DefaultDirName={autopf}\{#ProductName}
DefaultGroupName={#ProductName}
DisableProgramGroupPage=yes
DisableDirPage=auto
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
OutputDir={#OutputDir}
OutputBaseFilename=GDS-SecurePlusAgent-{#AppVersion}-win-x64-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
; GDS branding (generated by build/branding/make_branding.py).
SetupIconFile=gds.ico
WizardImageFile=WizardImage.bmp,WizardImage@2x.bmp
WizardSmallImageFile=WizardSmallImage.bmp,WizardSmallImage@2x.bmp
UninstallDisplayName={#ProductName}
UninstallDisplayIcon={app}\gds.ico
CloseApplications=yes
RestartApplications=no
SetupLogging=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "psmodules"; Description: "Install PowerShell 7 and the pinned modules for Exchange, Purview and Teams checks (internet needed)"; GroupDescription: "In-depth scans:"

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "gds.ico"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
Name: "{autoprograms}\{#ProductName}"; Filename: "{app}\{#ExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\gds.ico"
Name: "{autodesktop}\{#ProductName}"; Filename: "{app}\{#ExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\gds.ico"; Tasks: desktopicon

[Run]
; 4.0 beta.2: PowerShell 7 and ExchangeOnlineManagement 3.10.1 / MicrosoftTeams 8.0.0 for the read-only collector. A failure never fails the install.
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\prerequisites\Install-SecurePlusPowerShellModules.ps1"" -Scope AllUsers"; StatusMsg: "Installing PowerShell modules for in-depth scans..."; Flags: runhidden waituntilterminated; Tasks: psmodules
Filename: "{app}\{#ExeName}"; Description: "{cm:LaunchProgram,{#ProductName}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
; The background schedule runner is a Task Scheduler task the application registers for the signed-in user.
Filename: "{sys}\schtasks.exe"; Parameters: "/Delete /F /TN ""GDS Secure Plus Agent\Scheduled assessments"""; Flags: runhidden; RunOnceId: "RemoveScheduledAssessmentsTask"

[Code]
// 3.2: install type (Workstation / Server / All-in-one) and the shared SQL Server. The choice is written to
// %ProgramData%\Global Data Systems\Secure Plus Agent\install.json, which the application reads. Silent installs take
//   /TYPE=Workstation|Server|AllInOne  /SERVER=<sql server>  /DATABASE=<name, default SecurePlus>
// Server and All-in-one installs then run the application with --provision-database to create or upgrade the database.
// Uninstalling never touches the database.
const
  RegKey = 'SOFTWARE\Global Data Systems\Secure Plus Agent';

var
  TypePage: TInputOptionWizardPage;
  ServerPage: TInputQueryWizardPage;

function ParamOr(const Name, Default: String): String;
begin
  Result := ExpandConstant('{param:' + Name + '|' + Default + '}');
end;

function RegValue(const Name, Default: String): String;
begin
  if not RegQueryStringValue(HKLM, RegKey, Name, Result) then Result := Default;
end;

function InstallTypeName: String;
begin
  case TypePage.SelectedValueIndex of
    1: Result := 'Server';
    2: Result := 'AllInOne';
  else
    Result := 'Workstation';
  end;
end;

function SqlServerName: String;
begin
  Result := Trim(ServerPage.Values[0]);
end;

function DatabaseName: String;
begin
  Result := Trim(ServerPage.Values[1]);
  if Result = '' then Result := 'SecurePlus';
end;

procedure InitializeWizard;
var
  Kind: String;
begin
  TypePage := CreateInputOptionPage(wpSelectDir, 'Install type', 'How will this computer use Secure Plus?',
    'Choose Workstation for engineers'' and technicians'' computers. Choose Server for the one computer that creates and upgrades the shared database. All-in-one is for lab and test computers.',
    True, False);
  TypePage.Add('Workstation - the desktop app, using the shared database');
  TypePage.Add('Server - creates and upgrades the shared SQL Server database');
  TypePage.Add('All-in-one - server and workstation on one computer (lab/test)');
  Kind := Lowercase(ParamOr('TYPE', RegValue('InstallType', 'Workstation')));
  if Kind = 'server' then TypePage.SelectedValueIndex := 1
  else if (Kind = 'allinone') or (Kind = 'all-in-one') then TypePage.SelectedValueIndex := 2
  else TypePage.SelectedValueIndex := 0;

  ServerPage := CreateInputQueryPage(TypePage.ID, 'Shared database', 'Which SQL Server holds the Secure Plus database?',
    'Enter the SQL Server name, for example sql01.gds.local or sql01\SECUREPLUS. Secure Plus connects with your Windows account (office network or VPN). You can change this later in Settings > Database Configuration.');
  ServerPage.Add('SQL Server:', False);
  ServerPage.Add('Database name:', False);
  ServerPage.Values[0] := ParamOr('SERVER', RegValue('SqlServer', ''));
  ServerPage.Values[1] := ParamOr('DATABASE', RegValue('DatabaseName', 'SecurePlus'));
end;

function TestSqlServer(const Server: String; var Error: String): Boolean;
var
  Connection: Variant;
begin
  Result := False;
  try
    Connection := CreateOleObject('ADODB.Connection');
    Connection.ConnectionTimeout := 10;
    Connection.Open('Provider=SQLOLEDB;Data Source=' + Server + ';Initial Catalog=master;Integrated Security=SSPI;');
    Connection.Close;
    Result := True;
  except
    Error := GetExceptionMessage;
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Error: String;
begin
  Result := True;
  if CurPageID <> ServerPage.ID then exit;
  if SqlServerName = '' then
  begin
    if WizardSilent then
      Log('No SQL Server given (/SERVER=); it can be set later in Settings > Database Configuration.')
    else
    begin
      MsgBox('Enter the SQL Server that holds the Secure Plus database.', mbError, MB_OK);
      Result := False;
    end;
    exit;
  end;
  if not TestSqlServer(SqlServerName, Error) then
  begin
    Log('Connection test to ' + SqlServerName + ' failed: ' + Error);
    if not WizardSilent then
      Result := MsgBox('Secure Plus could not connect to ' + SqlServerName + ' with your Windows account:' + #13#10 + Error + #13#10#13#10 +
        'Check the name and that you are on the office network or VPN. Continue anyway? (You can fix it later in Settings > Database Configuration.)',
        mbConfirmation, MB_YESNO) = IDYES;
  end
  else
    Log('Connection test to ' + SqlServerName + ' succeeded.');
end;

function JsonText(const Value: String): String;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  Folder, Json: String;
  Code: Integer;
begin
  if CurStep <> ssPostInstall then exit;
  Folder := ExpandConstant('{commonappdata}\Global Data Systems\Secure Plus Agent');
  ForceDirectories(Folder);
  Json := '{' + #13#10 +
    '  "type": "' + InstallTypeName + '",' + #13#10 +
    '  "sqlServer": "' + JsonText(SqlServerName) + '",' + #13#10 +
    '  "databaseName": "' + JsonText(DatabaseName) + '"' + #13#10 + '}' + #13#10;
  if not SaveStringToFile(Folder + '\install.json', Json, False) then Log('install.json could not be written to ' + Folder);
  RegWriteStringValue(HKLM, RegKey, 'InstallType', InstallTypeName);
  RegWriteStringValue(HKLM, RegKey, 'SqlServer', SqlServerName);
  RegWriteStringValue(HKLM, RegKey, 'DatabaseName', DatabaseName);
  Log('Install type ' + InstallTypeName + ', SQL Server ' + SqlServerName + ', database ' + DatabaseName + '.');

  if (InstallTypeName <> 'Workstation') and (SqlServerName <> '') then
  begin
    WizardForm.StatusLabel.Caption := 'Creating or upgrading the Secure Plus database on ' + SqlServerName + '...';
    if Exec(ExpandConstant('{app}\{#ExeName}'), '--provision-database', ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, Code) then
    begin
      Log('Database provisioning finished with code ' + IntToStr(Code) + '.');
      if (Code <> 0) and not WizardSilent then
        MsgBox('The database on ' + SqlServerName + ' could not be created or upgraded (code ' + IntToStr(Code) + '). ' +
          'Open Secure Plus and use Settings > Database Configuration, or see the application log.', mbInformation, MB_OK);
    end
    else
      Log('Database provisioning could not be started: ' + SysErrorMessage(Code));
  end;
end;
